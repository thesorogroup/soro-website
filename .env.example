# Server-only Netlify variables for the private legacy-file import bridge.
# Set the real values in Netlify's environment-variable settings, never here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Recommended: Base64-encoded Google Cloud service-account JSON key.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternative OAuth configuration (use only if a service account is impractical).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Server-only Talent application email notifications. Configure in Netlify;
# never place a live API key in this file or commit one to Git.
RESEND_API_KEY=
APPLICATION_FROM_EMAIL=
APPLICATION_NOTIFICATION_EMAIL=talents@thesorogroup.com
APPLICATION_PORTAL_URL=https://thesorogroup.com/operations/
